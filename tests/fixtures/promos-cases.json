{
    "_comment": "Общие случаи плашки «Сейчас действует»: по ним проверяются и PHP (PromoSchedule, Pest), и JS (promos-now.js, node --test). Перенесены из tools/tests/promos.test.mjs старого сайта. 5 октября 2026 — понедельник. Ответ — kind:id:label.",
    "rules": {
        "holidays": ["01-01", "05-09", "11-04"],
        "no_dates": ["2026-10-09"],
        "promos": [
            {"id": "mujskie-dni", "title": "Мужские дни", "short": "−50%", "when": {"days": [3]}},
            {"id": "happyhours", "title": "Счастливые часы", "short": "−25%", "when": {"days": [1, 2, 3, 4, 5], "from": "12:00", "to": "15:00", "not_holidays": true}}
        ]
    },
    "cases": [
        {"name": "будни в 14:00 — счастливые часы идут, до 15:00", "at": "2026-10-05 14:00", "expect": ["live:happyhours:Сейчас, до 15:00"]},
        {"name": "будни утром — счастливые часы позже сегодня", "at": "2026-10-05 10:30", "expect": ["today:happyhours:Сегодня с 12:00"]},
        {"name": "ровно в 15:00 счастливые часы закончились — показываем ближайшее", "at": "2026-10-05 15:00", "expect": ["soon:happyhours:Завтра с 12:00"]},
        {"name": "среда в 14:00 — обе акции, обе идут", "at": "2026-10-07 14:00", "expect": ["live:mujskie-dni:Сегодня весь день", "live:happyhours:Сейчас, до 15:00"]},
        {"name": "среда утром — мужские дни уже идут, счастливые часы позже", "at": "2026-10-07 09:00", "expect": ["live:mujskie-dni:Сегодня весь день", "today:happyhours:Сегодня с 12:00"]},
        {"name": "пятница вечером — в понедельник с 12:00", "at": "2026-10-09 20:00", "expect": ["soon:happyhours:В понедельник с 12:00"]},
        {"name": "день концерта: счастливые часы не идут, мужские дни не затронуты", "at": "2026-10-09 13:00", "expect": ["soon:happyhours:В понедельник с 12:00"]},
        {"name": "праздник 4 ноября (среда): только мужские дни", "at": "2026-11-04 13:00", "expect": ["live:mujskie-dni:Сегодня весь день"]},
        {"name": "вторник после 15:00 — завтра обе, сначала та, что весь день", "at": "2026-10-06 16:00", "expect": ["soon:mujskie-dni:Завтра", "soon:happyhours:Завтра с 12:00"]},
        {"name": "без акций со временем — пусто", "at": "2026-10-05 14:00", "promos": [], "expect": []},
        {"name": "акция с периодом до начала — показываем первый день периода", "at": "2026-10-05 14:00", "promos": [{"id": "fest", "title": "Октоберфест", "short": "−20%", "when": {"days": [1, 2, 3, 4, 5, 6, 7], "since": "2026-10-07", "until": "2026-10-08"}}], "expect": ["soon:fest:В среду"]},
        {"name": "акция с периодом в последний день — идёт весь день", "at": "2026-10-08 23:00", "promos": [{"id": "fest", "title": "Октоберфест", "short": "−20%", "when": {"days": [1, 2, 3, 4, 5, 6, 7], "since": "2026-10-07", "until": "2026-10-08"}}], "expect": ["live:fest:Сегодня весь день"]},
        {"name": "акция с периодом после конца — пусто", "at": "2026-10-09 10:00", "promos": [{"id": "fest", "title": "Октоберфест", "short": "−20%", "when": {"days": [1, 2, 3, 4, 5, 6, 7], "since": "2026-10-07", "until": "2026-10-08"}}], "expect": []},
        {"name": "суббота днём — в понедельник с 12:00", "at": "2026-10-10 13:00", "expect": ["soon:happyhours:В понедельник с 12:00"]},
        {"name": "воскресенье — завтра с 12:00", "at": "2026-10-11 18:00", "expect": ["soon:happyhours:Завтра с 12:00"]},
        {"name": "понедельник после 15:00 перед праздничным вторником — во вторник ничего, в среду обе", "at": "2026-05-04 16:00", "rules": {"holidays": ["05-05"]}, "expect": ["soon:mujskie-dni:В среду", "soon:happyhours:В среду с 12:00"]},
        {"name": "воскресенье, понедельник — праздник: во вторник с 12:00", "at": "2026-12-27 18:00", "rules": {"no_dates": ["2026-12-28"]}, "expect": ["soon:happyhours:Во вторник с 12:00"]},
        {"name": "счастливые часы в 11:59 — ещё не начались", "at": "2026-10-05 11:59", "expect": ["today:happyhours:Сегодня с 12:00"]},
        {"name": "счастливые часы в 12:00 — уже идут", "at": "2026-10-05 12:00", "expect": ["live:happyhours:Сейчас, до 15:00"]}
    ]
}
